# Copy to .env.local for development. Both values are compiled into the client
# bundle and are public by design — the anon key is the one browsers are meant
# to hold, and row-level security in supabase/schema.sql is what guards the data.
#
# Find them in the Supabase dashboard under Settings -> API.
# Leave them unset and the site still builds: sign-in and the dashboard report
# that they are not connected yet, and the showcase reads from
# src/data/projects.ts as it always has.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
